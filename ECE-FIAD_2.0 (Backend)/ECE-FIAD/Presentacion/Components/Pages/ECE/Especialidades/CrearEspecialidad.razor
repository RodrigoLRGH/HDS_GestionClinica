@page "/crear-especialidad"

<div class="container mt-4">
	<div class="row justify-content-center">
		<div class="col-lg-8 col-md-10 col-sm-12">
			<div class="card shadow-lg border-0 rounded-4">
				<div class="card-header bg-success bg-gradient text-white">
					<h5 class="mb-0">
						<i class="fas fa-user-plus me-2"></i>Registro de nueva Especialidad
					</h5>
				</div>
				<div class="card-body p-4">
					<EditForm Model="@especialidadDto" OnValidSubmit="@GrabarEspecialidad">
						<FluentValidator />
						<div class="row">
							<div class="col-md-6 mb-3">
								<label for="especialidad" class="form-label fw-semibold">
									<i class="fas fa-user me-1"></i> Especialidad
								</label>

								<InputText id="nombres" class="form-control" placeholder="Ej: Tos" @bind-Value="especialidadDto.Nombre" />

								<ValidationMessage For="@(() => especialidadDto.Nombre)" class="text-danger small" />
							</div>

						</div>
						<div class="col-md-6 mb-3">
							<label for="descripcion" class="form-label fw-semibold">
								<i class="fas fa-map-marker-alt me-1"></i> Descripcion
							</label>

							<InputText id="direccion" class="form-control" placeholder="Ej: Especialidad en..." @bind-Value="especialidadDto.Descripcion" />

						</div>
						<div class="d-flex justify-content-end gap-2 mt-3">
							<button type="button" class="btn btn-secondary px-4" @onclick="Cancelar">
								<i class="fas fa-times me-1"></i> Cancelar
							</button>
							<button type="submit" class="btn btn-success px-4">
								<i class="fas fa-save me-1"></i> Guardar Especialidad
							</button>
						</div>
					</EditForm>
				</div>
			</div>
		</div>
	</div>
</div>
