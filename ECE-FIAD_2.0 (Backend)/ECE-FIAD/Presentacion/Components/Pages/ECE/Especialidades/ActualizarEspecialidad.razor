@page "/editar-especialidad/{id:int}"
@inject IEspecialidadService EspecialidadService
@inject IToastrService Toastr
@inject NavigationManager Navigation
<div class="container mt-4">
	<div class="row justify-content-center">
		<div class="col-lg-8 col-md-10 col-sm-12">
			<div class="card shadow-lg border-0">
				<div class="card-header bg-warning text-dark">
					<h5 class="mb-0">
						<i class="fas fa-user-edit me-2"></i>Editar Especialidad: @especialidadOriginal?.Nombre
					</h5>
				</div>
				<div class="card-body p-4">
					@if (especialidadOriginal == null)
					{
						<div class="alert alert-info text-center">
							<i class="fas fa-spinner fa-pulse me-2"></i>Cargando datos de la especialidad...
						</div>
					}
					else
					{
						<EditForm Model="@especialidadEditar" OnValidSubmit="@GrabarEspecialidad">
							<FluentValidator />
							<!-- Campos editables -->
							<div class="row">
								<div class="col-md-6 mb-3">
									<label class="form-label fw-semibold text-muted">
										<i class="fas fa-id-card me-1"></i> ID
									</label>
									<p class="form-control-plaintext fw-bold bg-light">@especialidadOriginal.Id</p>
								</div>
								<div class="col-md-6 mb-3">
									<label for="nombre" class="form-label fw-semibold">
										<i class="fas fa-user me-1"></i> Nombre
									</label>
									<InputText id="nombre" class="form-control fw-bold bg-light" placeholder="Ej: Cancer" @bind-Value="especialidadEditar.Nombre" />
									<ValidationMessage For="@(() => especialidadEditar.Nombre)" class="text-danger small" />
								</div>
								<div class="col-md-6 mb-3">
									<label for="descripcion" class="form-label fw-semibold">
										<i class="fas fa-user me-1"></i> Descripcion
									</label>
									<InputText id="descripcion" class="form-control fw-bold bg-light" placeholder="Ej: Bla bla bla" @bind-Value="especialidadEditar.Descripcion" />
									<ValidationMessage For="@(() => especialidadEditar.Descripcion)" class="text-danger small" />
								</div>

							</div>
							<div class="d-flex justify-content-end gap-2 mt-3">
								<button type="button" class="btn btn-secondary px-4" @onclick="Cancelar">
									<i class="fas fa-times me-1"></i> Cancelar
								</button>
								<button type="submit" class="btn btn-primary px-4">
									<i class="fas fa-save me-1"></i> Actualizar Especialidad
								</button>
							</div>
						</EditForm>
					}
				</div>
			</div>
		</div>
	</div>
</div>
@code {
}