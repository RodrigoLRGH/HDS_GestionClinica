@page "/especialidades"
@* Este código no usa paginación aún*@
<div class="container mt-4">
	<div class="card shadow-lg border-0 rounded-4">
		<div class="card-header bg-primary text-white rounded-top-4">
			<div class="d-flex justify-content-between align-items-center">
				<h4 class="mb-0">
					<i class="fas fa-users me-2"></i>Listado de especialidades
				</h4>
				<button class="btn btn-success" @onclick="NavegarACrear">
					<i class="fas fa-plus-circle me-1"></i> Nueva Especialidad
				</button>
			</div>
		</div>
		<div class="card-body p-2 bg-primary-subtle">

			@* Si paciente es nulo se están cargando datos*@
			@if (especialidades == null)
			{
				<div class="text-center py-5">
					<i class="fas fa-spinner fa-pulse fa-2x text-primary"></i>
					<p class="mt-2">Cargando especialidades...</p>
				</div>
			}
			else
					@* Si paciente no tiene datos*@
					if (!especialidades.Any())
			{
				<div class="alert alert-info text-center">
					<i class="fas fa-info-circle me-2"></i> No hay especialidades registradas.
					<a href="#" @onclick:preventDefault="true" @onclick="NavegarACrear">Crear la primera</a>
				</div>
			}
			else
			{
				@* Listado Table *@
				{
					<div class="table-responsive">
						<table class="table table-hover align-middle">
							<thead class="table-light">
								<tr>
									<th>Nombre</th>
									<th>Descripcion</th>
									<th>Doctores asociados</th>
									<th>Estado</th>
									<th class="text-center">Acciones</th>
								</tr>
							</thead>
							<tbody>
								@foreach (var especialidad in especialidades)
								{
									<tr>
										<td>@especialidad.Nombre</td>
										@if (especialidad.Descripcion != string.Empty)
										{
										<td>@especialidad.Descripcion</td>
										}
										else
										{
											<td>Sin descripcion</td>
										}

										@if (especialidad.CantidadDoctores == 0)
										{
											<td>Ningun doctor</td>
										}
										else
										{
											<td>@especialidad.CantidadDoctores Doctores asociados</td>
										}
										
										<td>
											@if (especialidad.Activo)
											{
												<span class="badge bg-success">Activo</span>
											}
											else
											{

												<span class="badge bg-secondary">Inactivo</span>
											}
										</td>

										<td class="text-center">

											<button class="btn btn-sm btn-info me-1" title="Ver detalles" @onclick="() =>VerDetalles(especialidad.Id)">
												<i class="fas fa-eye"></i>
											</button>

											<button class="btn btn-sm btn-warning me-1" title="Editar" @onclick="() =>Editar(especialidad.Id)">
												<i class="fas fa-edit"></i>
											</button>

											<button class="btn btn-sm btn-danger" title="Eliminar" @onclick="() =>ConfirmarEliminar(especialidad.Id, especialidad.Nombre)">
												<i class="fas fa-trash-alt"></i>
											</button>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			}
		</div>
	</div>
</div>