@page "/citas"

<div class="container mt-4">
	<div class="card shadow-lg border-0 rounded-4">
		<div class="card-header bg-primary text-white rounded-top-4">
			<div class="d-flex justify-content-between align-items-center">
				<h4 class="mb-0">
					<i class="fas fa-calendar-check me-2"></i>Listado de Citas
				</h4>
				<button class="btn btn-success" @onclick="NavegarACrear">
					<i class="fas fa-plus-circle me-1"></i> Nueva Cita
				</button>
			</div>
		</div>

		<div class="card-body p-2 bg-primary-subtle">

			<div class="d-flex justify-content-end">
				<button class="btn btn-sm btn-warning mt-0 m-2"
						@onclick="CambiaEstilo">
					<i class="@(EstiloCard ? "fas fa-list" : "fas fa-th")"></i>
					@(EstiloCard ? "Formato Listado" : "Formato Card")
				</button>
			</div>

			@if (citas == null)
			{
				<div class="text-center py-5">
					<i class="fas fa-spinner fa-pulse fa-2x text-primary"></i>
					<p class="mt-2">Cargando citas...</p>
				</div>
			}
			else if (!citas.Any())
			{
				<div class="alert alert-info text-center">
					No hay citas registradas.
					<a href="#" @onclick="NavegarACrear">Crear la primera</a>
				</div>
			}
			else
			{
				if (EstiloCard)
				{
					<!-- 🔵 CARDS -->
					<div class="row g-4">
						@foreach (var cita in citas)
						{
							<div class="col-md-6 col-lg-4">
								<div class="card-paciente">
									<div>
										<h5>@cita.Paciente.NombreCompleto</h5>
										<p class="mb-0">
											<i class="fas fa-user-md"></i>
											@cita.Doctor.NombreCompleto
										</p>
										<p class="mb-0">
											<i class="fas fa-clock"></i>
											@cita.FechaHora.ToString("dd/MM/yyyy HH:mm")
										</p>
									</div>

									<hr />

									<div>
										<b>Motivo:</b> @cita.Motivo
									</div>

									<div class="mt-2">
										<span class="badge @(cita.Estado switch {
												EstadoCita.Confirmada => "bg-success",
												EstadoCita.Cancelada => "bg-danger",
												EstadoCita.Completada => "bg-primary",
												_ => "bg-warning"
											})">
											@cita.Estado
										</span>
									</div>

									<div class="d-flex justify-content-end mt-3">
										<button class="btn btn-sm btn-info me-1"
												@onclick="() => VerDetalles(cita.Id)">
											<i class="fas fa-eye"></i>
										</button>

										<button class="btn btn-sm btn-warning me-1"
												@onclick="() => Editar(cita.Id)">
											<i class="fas fa-edit"></i>
										</button>

										<button class="btn btn-sm btn-danger"
												@onclick="() => ConfirmarEliminar(cita)">
											<i class="fas fa-trash-alt"></i>
										</button>
									</div>
								</div>
							</div>
						}
					</div>
				}
				else
				{
					<!-- 🔵 TABLA -->
					<div class="table-responsive">
						<table class="table table-hover align-middle">
							<thead class="table-light">
								<tr>
									<th class="text-center">Paciente</th>
									<th class="text-center">Doctor</th>
									<th class="text-center">Fecha</th>
									<th class="text-center">Motivo</th>
									<th class="text-center">Estado</th>
									<th class="text-center">Acciones</th>
								</tr>
							</thead>
							<tbody>
								@foreach (var cita in citas)
								{
									<tr>
										<td>@cita.Paciente.NombreCompleto</td>
										<td>@cita.Doctor.NombreCompleto</td>
										<td>@cita.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
										<td>@cita.Motivo</td>

										<td>
											<span class="badge @(cita.Estado switch {
												EstadoCita.Confirmada => "bg-success",
												EstadoCita.Cancelada => "bg-danger",
												EstadoCita.Completada => "bg-primary",
												_ => "bg-warning"
											})">
												@cita.Estado
											</span>
										</td>

										<td class="text-center">
											<button class="btn btn-sm btn-info me-1"
													@onclick="() => VerDetalles(cita.Id)">
												<i class="fas fa-eye"></i>
											</button>

											<button class="btn btn-sm btn-warning me-1"
													@onclick="() => Editar(cita.Id)">
												<i class="fas fa-edit"></i>
											</button>

											<button class="btn btn-sm btn-danger"
													@onclick="() => ConfirmarEliminar(cita)">
												<i class="fas fa-trash-alt"></i>
											</button>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			}
		</div>
	</div>
</div>