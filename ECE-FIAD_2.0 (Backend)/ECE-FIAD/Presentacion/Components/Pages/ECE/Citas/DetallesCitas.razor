@page "/detalles-cita/{id:int}"

<div class="container mt-4">
	<div class="row justify-content-center">
		<div class="col-lg-8 col-md-10 col-sm-12">
			<div class="card shadow-lg border-0 rounded-4">

				<div class="card-header bg-info text-white text-center rounded-top-4">
					<h4 class="mb-0">
						<i class="fas fa-calendar-alt me-2"></i>Detalles de la Cita
					</h4>
				</div>

				<div class="card-body p-4">
					@if (cargando)
					{
						<div class="text-center my-4">
							<div class="spinner-border text-info" role="status">
								<span class="visually-hidden">Cargando...</span>
							</div>
							<p class="mt-2">Cargando datos...</p>
						</div>
					}
					else if (cita == null)
					{
						<div class="alert alert-warning text-center">
							<i class="fas fa-exclamation-triangle me-2"></i>Cita no encontrada
						</div>
					}
					else
					{
						<div class="row">
							<!-- Paciente -->
							<div class="col-md-6 mb-3">
								<label class="form-label fw-semibold text-muted">
									<i class="fas fa-user me-1"></i> Paciente
								</label>
								<p class="form-control-plaintext fw-bold bg-light px-2 rounded">
									@(pacientes.FirstOrDefault(p => p.Id == cita.IdPaciente)?.Nombres ?? "—")
								</p>
							</div>

							<!-- Doctor -->
							<div class="col-md-6 mb-3">
								<label class="form-label fw-semibold text-muted">
									<i class="fas fa-user-md me-1"></i> Doctor
								</label>
								<p class="form-control-plaintext fw-bold bg-light px-2 rounded">
									@(doctores.FirstOrDefault(d => d.Id == cita.IdDoctor)?.Nombres ?? "—")
								</p>
							</div>

							<!-- Fecha y Hora -->
							<div class="col-md-6 mb-3">
								<label class="form-label fw-semibold text-muted">
									<i class="fas fa-clock me-1"></i> Fecha y Hora
								</label>
								<p class="form-control-plaintext fw-bold bg-light px-2 rounded">
									@cita.FechaHora.ToString("dd/MM/yyyy HH:mm")
								</p>
							</div>

							<!-- Estado -->
							<div class="col-md-6 mb-3">
								<label class="form-label fw-semibold text-muted">
									<i class="fas fa-info-circle me-1"></i> Estado
								</label>
								<p class="form-control-plaintext px-2">
									<span class="badge @(cita.Estado switch {
												EstadoCita.Confirmada => "bg-success",
												EstadoCita.Cancelada => "bg-danger",
												EstadoCita.Completada => "bg-primary",
												_ => "bg-warning"
											})">
										@cita.Estado
									</span>
								</p>
							</div>

							<!-- Motivo -->
							<div class="col-md-12 mb-3">
								<label class="form-label fw-semibold text-muted">
									<i class="fas fa-comment-medical me-1"></i> Motivo
								</label>
								<p class="form-control-plaintext fw-bold bg-light px-2 rounded">
									@(string.IsNullOrEmpty(cita.Motivo) ? "—" : cita.Motivo)
								</p>
							</div>

							<!-- Notas -->
							<div class="col-md-12 mb-3">
								<label class="form-label fw-semibold text-muted">
									<i class="fas fa-sticky-note me-1"></i> Notas
								</label>
								<p class="form-control-plaintext fw-bold bg-light px-2 rounded">
									@(string.IsNullOrEmpty(cita.Notas) ? "—" : cita.Notas)
								</p>
							</div>

						</div>

						<div class="d-flex justify-content-end gap-2 mt-3">
							<button class="btn btn-secondary px-4" @onclick="Volver">
								<i class="fas fa-arrow-left me-1"></i> Volver
							</button>
							<button class="btn btn-warning px-4" @onclick="Editar">
								<i class="fas fa-edit me-1"></i> Editar Cita
							</button>
						</div>
					}
				</div>
			</div>
		</div>
	</div>
</div>