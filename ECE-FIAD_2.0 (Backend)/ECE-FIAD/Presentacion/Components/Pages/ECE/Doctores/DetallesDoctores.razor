@page "/detalles-doctor/{id:int}"

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10 col-sm-12">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-info text-white text-center rounded-top-4">
                    <h4 class="mb-0">
                        <i class="fas fa-user-circle me-2"></i>Detalles del Doctor
                    </h4>
                </div>
                <div class="card-body p-4">
                    @if (doctor == null)
                    {
                        <div class="alert alert-warning text-center">
                            <i class="fas fa-exclamation-triangle me-2"></i>Cargando información...
                        </div>
                    }
                    else
                    {

                        <div class="row mb-4">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold text-muted">
                                    <i class="fas fa-user me-1"></i> Id
                                </label>
                                <p class="form-control-plaintext fw-bold bg-light px-2">
                                    @doctor.Id
                                </p>
                            </div>
                            <!-- Nombres -->
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold text-muted">
                                    <i class="fas fa-user me-1"></i> Nombres
                                </label>
                                <p class="form-control-plaintext fw-bold bg-light px-2">
                                    @doctor.Nombres
                                </p>
                            </div>

                            <!-- Apellidos -->
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold text-muted">
                                    <i class="fas fa-user me-1"></i> Apellidos
                                </label>
                                <p class="form-control-plaintext fw-bold bg-light px-2">
                                    @doctor.Apellidos
                                </p>
                            </div>

                            <!-- Teléfono -->
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold text-muted">
                                    <i class="fas fa-phone me-1"></i> Teléfono
                                </label>
                                <p class="form-control-plaintext fw-bold bg-light px-2">
                                    @doctor.Telefono
                                </p>
                            </div>

                            <!-- Email -->
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold text-muted">
                                    <i class="fas fa-envelope me-1"></i> Email
                                </label>
                                <p class="form-control-plaintext fw-bold bg-light px-2">
                                    @doctor.Email
                                </p>
                            </div>

                            <!-- Horario -->
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold text-muted">
                                    <i class="fas fa-clock me-1"></i> Horario de atención
                                </label>
                                <p class="form-control-plaintext fw-bold bg-light px-2">
                                    @doctor.HorarioAtencion
                                </p>
                            </div>

                            <!-- Especialidad -->
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold text-muted">
                                    <i class="fas fa-briefcase-medical me-1"></i> Especialidad
                                </label>
                                <InputSelect id="especialidad" class="form-select" @bind-Value="doctor.IdEspecialidad" disabled>
                                    <option value="">Seleccione...</option>
                                    @foreach (var item in especialidades)
                                    {
                                        <option value="@item.Id">@item.Nombre</option>
                                    }
                                </InputSelect>
                            </div

                            <div class="col-md-6 mb-3">
								<label class="form-label fw-semibold text-muted">
									<i class="fas fa-align-left me-1"></i> Descripción
								</label>
								<p class="form-control-plaintext fw-bold bg-light">
									@doctor.Descripcion
								</p>
							</div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold text-muted">
                                    <i class="fas fa-clock me-1"></i> Fecha de Contratacion
                                </label>
                                <p class="form-control-plaintext fw-bold bg-light px-2">
                                    @doctor.FechaContratacion
                                </p>
                            </div>
                        </div>

                       
                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="button" class="btn btn-secondary px-4" @onclick="Volver">
                                <i class="fas fa-arrow-left me-1"></i> Volver al listado
                            </button>
                            <button type="button" class="btn btn-primary px-4" @onclick="Editar">
                                <i class="fas fa-edit me-1"></i> Editar doctor
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>