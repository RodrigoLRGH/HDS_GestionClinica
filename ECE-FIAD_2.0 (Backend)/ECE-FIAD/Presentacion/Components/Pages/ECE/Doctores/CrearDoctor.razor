@page "/crear-doctor"

<div class="container mt-4">
	<div class="row justify-content-center">
		<div class="col-lg-8 col-md-10 col-sm-12">
			<div class="card shadow-lg border-0 rounded-4">
				<div class="card-header bg-success bg-gradient text-white">
					<h5 class="mb-0">
						<i class="fas fa-user-plus me-2"></i>Registro de nuevo doctor
					</h5>
				</div>
				<div class="card-body p-4">
					<EditForm Model="@doctorDto" OnValidSubmit="@GrabarDoctor">
						<FluentValidator />
						<div class="row">
							<div class="col-md-6 mb-3">
								<label for="nombres" class="form-label fw-semibold">
									<i class="fas fa-user me-1"></i> Nombres
								</label>

								<InputText id="nombres" class="form-control" placeholder="Ej: Juan Carlos" @bind-Value="doctorDto.Nombres" />

								<ValidationMessage For="@(() => doctorDto.Nombres)" class="text-danger small" />
							</div>
							<div class="col-md-6 mb-3">
								<label for="apellidos" class="form-label fw-semibold">
									<i class="fas fa-user me-1"></i> Apellidos
								</label>

								<InputText id="apellidos" class="form-control" placeholder="Ej: Pérez Gómez" @bind-Value="doctorDto.Apellidos" />

								<ValidationMessage For="@(() => doctorDto.Apellidos)" class="text-danger small" />
							</div>
						</div>
						<div class="row">
							<div class="col-md-6 mb-3">
								<label for="telefono" class="form-label fw-semibold">
									<i class="fas fa-phone me-1"></i> Teléfono
								</label>

								<InputText id="telefono" class="form-control" placeholder="Ej: 8095551234" @bind-Value="doctorDto.Telefono" />

							</div>
							<div class="col-md-6 mb-3">
								<label for="email" class="form-label fw-semibold">
									<i class="fas fa-envelope me-1"></i> Email
								</label>

								<InputText id="email" class="form-control" placeholder="Ej: juan@example.com" @bind-Value="doctorDto.Email" />
								<ValidationMessage For="@(() => doctorDto.Email)" class="text-danger small" />
							</div>
						</div>
						<div class="row">
							<div class="col-md-6 mb-3">
								<label for="horarioAtencion" class="form-label fw-semibold">
									<i class="fas fa-calendar-alt me-1"></i> Horario de atencion
								</label>
								<InputText id="horarioAtencion" class="form-control" @bind-Value="doctorDto.HorarioAtencion" />
								<ValidationMessage For="@(() => doctorDto.HorarioAtencion)" class="text-danger small" />
							</div>
							<div class="col-md-6 mb-3">
								<label for="genero" class="form-label fw-semibold">
									<i class="fas fa-venus-mars me-1"></i> Especialidad
								</label>
								<InputSelect id="especialidad" class="form-select" @bind-Value="doctorDto.IdEspecialidad">
									<option value="">Seleccione...</option>
									@foreach (var item in especialidades)
									{
										<option value="@item.Id">@item.Nombre</option>
									}
								</InputSelect>
							</div>
						</div>
						<div class="row">
							<div class="col-md-6 mb-3">
								<label for="fechaContratacion" class="form-label fw-semibold">
									<i class="fas fa-calendar-alt me-1"></i> Fecha de Contratacion
								</label>
								<InputDate id="fechaContratacion" class="form-control" @bind-Value="doctorDto.FechaContratacion" />
								<ValidationMessage For="@(() => doctorDto.FechaContratacion)" class="text-danger small" />
							</div>
							<div class="col-md-6 mb-3">
								<label for="descripcion" class="form-label fw-semibold">
									<i class="fas fa-map-marker-alt me-1"></i> Descripcion
								</label>

								<InputText id="direccion" class="form-control" placeholder="Ej: Especialidad en..." @bind-Value="doctorDto.Descripcion" />

							</div>
						</div>
						<div class="d-flex justify-content-end gap-2 mt-3">
							<button type="button" class="btn btn-secondary px-4" @onclick="Cancelar">
								<i class="fas fa-times me-1"></i> Cancelar
							</button>
							<button type="submit" class="btn btn-success px-4">
								<i class="fas fa-save me-1"></i> Guardar Doctor
							</button>
						</div>
					</EditForm>
				</div>
			</div>
		</div>
	</div>
</div>