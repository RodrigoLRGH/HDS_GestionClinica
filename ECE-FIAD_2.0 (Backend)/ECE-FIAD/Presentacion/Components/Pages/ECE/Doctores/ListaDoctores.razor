@page "/doctores"


@* Este código no usa paginación aún*@
<div class="container mt-4">
	<div class="card shadow-lg border-0 rounded-4">
		<div class="card-header bg-primary text-white rounded-top-4">
			<div class="d-flex justify-content-between align-items-center">
				<h4 class="mb-0">
					<i class="fas fa-users me-2"></i>Listado de Doctores
				</h4>
				<button class="btn btn-success" @onclick="NavegarACrear">
					<i class="fas fa-plus-circle me-1"></i> Nuevo Doctor
				</button>
			</div>
		</div>
		<div class="card-body p-2 bg-primary-subtle">
			@* Botón para cambiar el estilo del listado Card o Tabla *@
			<div class="d-flex justify-content-end">
				<button class="btn btn-sm btn-warning mt-0 m-2 " title="Listado" @onclick="() => CambiaEstilo()" style="text-transform: none;">
					<i class="@(EstiloCard ? "fas fa-list" : "fas fa-th")"></i>
					@(EstiloCard ? "Formato Listado" : "Formato Card")
				</button>
			</div>
			@* Si doctor es nulo se están cargando datos*@
			@if (doctores == null)
			{
				<div class="text-center py-5">
					<i class="fas fa-spinner fa-pulse fa-2x text-primary"></i>
					<p class="mt-2">Cargando doctores...</p>
				</div>
			}
			else
					@* Si doctor no tiene datos*@
					if (!doctores.Any())
			{
				<div class="alert alert-info text-center">
					<i class="fas fa-info-circle me-2"></i> No hay doctores registrados.
					<a href="#" @onclick:preventDefault="true" @onclick="NavegarACrear">Crear el primero</a>
				</div>
			}
			else
			{
				@* doctor si tiene datos*@
				if (EstiloCard)
				@* Listado Card *@
				{
					<div class="row g-4">
						@foreach (var doctor in doctores)
						{
							<div class="col-md-6 col-lg-4">
								<div class="card-paciente">
									<div class="d-flex align-items-center justify-content-between">
										<div class="d-flex align-items-center">
											<div class="ms-3">
												<h5 class="mt-0 mb-0">@doctor.Nombres @doctor.Apellidos</h5>
												<p class="mt-0 mb-0"><small><i class="fas fa-envelope"></i>@doctor.Email</small></p>
												<p class="mt-0 mb-0"><small><i class="fas fa-phone"></i>@doctor.Telefono</small></p>
											</div>
										</div>
									</div>
									<hr />

									<div class="mb-0">
										<i class="fas fa-calendar-alt"></i><b> Última cita</b>: Sin cita.
									</div>

									<div class="d-flex justify-content-end">

										<button class="btn btn-sm btn-info me-1" title="Ver detalles" @onclick="() =>VerDetalles(doctor.Id)">
											<i class="fas fa-eye"></i>
										</button>

										<button class="btn btn-sm btn-warning me-1" title="Editar" @onclick="() =>Editar(doctor.Id)">
											<i class="fas fa-edit"></i>
										</button>

										<button class="btn btn-sm btn-danger" title="Eliminar" @onclick="() =>ConfirmarEliminar(doctor.Id, doctor.Nombres, doctor.Apellidos)">
											<i class="fas fa-trash-alt"></i>
										</button>
									</div>
								</div>
							</div>
						}
					</div>
				}
				else
				@* Listado Table *@
				{
					<div class="table-responsive">
						<table class="table table-hover align-middle">
							<thead class="table-light">
								<tr>
									<th>Nombre</th>
									<th>Especialidad</th>
									<th>Telefono</th>
									<th>Email</th>
									<th>Fecha de Contratacion</th>
									<th>Estado</th>
									<th class="text-center">Acciones</th>
								</tr>
							</thead>
							<tbody>
								@foreach (var doctor in doctores)
								{
									<tr>
										<td>@doctor.Nombres @doctor.Apellidos</td>
										<th>@doctor.Especialidad.Nombre</th>
										<th>@doctor.Telefono</th>
										<th>@doctor.Email</th>
										<td>@(doctor.FechaContratacion.ToString("dd/MM/yyyy") ?? "Sin fecha")</td>
										<td>
											@if (doctor.Activo)
											{
												<span class="badge bg-success">Activo</span>
											}
											else
											{

												<span class="badge bg-secondary">Inactivo</span>
											}
										</td>

										<td class="text-center">

											<button class="btn btn-sm btn-info me-1" title="Ver detalles" @onclick="() =>VerDetalles(doctor.Id)">
												<i class="fas fa-eye"></i>
											</button>

											<button class="btn btn-sm btn-warning me-1" title="Editar" @onclick="() =>Editar(doctor.Id)">
												<i class="fas fa-edit"></i>
											</button>

											<button class="btn btn-sm btn-danger" title="Eliminar" @onclick="() =>ConfirmarEliminar(doctor.Id, doctor.Nombres, doctor.Apellidos)">
												<i class="fas fa-trash-alt"></i>
											</button>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			}
		</div>
	</div>
</div>