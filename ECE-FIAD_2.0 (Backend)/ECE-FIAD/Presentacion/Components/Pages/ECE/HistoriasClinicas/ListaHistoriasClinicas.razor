@page "/historias-clinicas"

<div class="container mt-4">
	<div class="card shadow-lg border-0 rounded-4">
		<div class="card-header bg-primary text-white rounded-top-4">
			<div class="d-flex justify-content-between align-items-center">
				<h4 class="mb-0">
					<i class="fas fa-calendar-check me-2"></i>Listado de Historias Clinicas
				</h4>
				<button class="btn btn-success" @onclick="NavegarACrear">
					<i class="fas fa-plus-circle me-1"></i> Nueva Historia Clinica
				</button>
			</div>
		</div>

		<div class="card-body p-2 bg-primary-subtle">

			@if (historiasClinicas == null)
			{
				<div class="text-center py-5">
					<i class="fas fa-spinner fa-pulse fa-2x text-primary"></i>
					<p class="mt-2">Cargando historias...</p>
				</div>
			}
			else if (!historiasClinicas.Any())
			{
				<div class="alert alert-info text-center">
					No hay historias clinicas registradas.
					<a href="#" @onclick="NavegarACrear">Crear la primera</a>
				</div>
			}
			else
			{

				<!-- 🔵 TABLA -->
				<div class="table-responsive">
					<table class="table table-hover align-middle">
						<thead class="table-light">
							<tr>
								<th class="text-center">Paciente</th>
								<th class="text-center">Fecha de Apertura</th>
								<th class="text-center">Alergias</th>
								<th class="text-center">Antecedentes Familiares</th>
								<th class="text-center">Estado</th>
								<th class="text-center">Acciones</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var historiaClinica in historiasClinicas)
							{
								<tr>
									<td>@historiaClinica.Paciente.NombreCompleto</td>
									<td>@historiaClinica.FechaApertura.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
									<td>@Truncar(historiaClinica.Alergias)</td>
									<td>@Truncar(historiaClinica.AntecedentesFamiliares)</td>
									<td>
										@if (historiaClinica.Activo)
										{
											<span class="badge bg-success fs-6">Activo</span>
										}
										else
										{
											<span class="badge bg-secondary fs-6">Inactivo</span>
										}
									</td>
									<td class="text-center">
										<button class="btn btn-sm btn-info me-1"
												@onclick="() => VerDetalles(historiaClinica.Id)">
											<i class="fas fa-eye"></i>
										</button>

										<button class="btn btn-sm btn-warning me-1"
												@onclick="() => Editar(historiaClinica.Id)">
											<i class="fas fa-edit"></i>
										</button>

										<button class="btn btn-sm btn-danger"
												@onclick="() => ConfirmarEliminar(historiaClinica)">
											<i class="fas fa-trash-alt"></i>
										</button>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>

			}
		</div>
	</div>
</div>