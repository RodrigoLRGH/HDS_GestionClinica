@page "/detalles-evolucion/{id:int}"

<div class="container mt-4">
	<div class="row justify-content-center">
		<div class="col-lg-8 col-md-10 col-sm-12">
			<div class="card shadow-lg border-0 rounded-4">

				<div class="card-header bg-info text-white text-center rounded-top-4">
					<h4 class="mb-0">
						<i class="fas fa-notes-medical me-2"></i>Detalles de la Evolución
					</h4>
				</div>

				<div class="card-body p-4">

					@if (evolucion == null)
					{
						<div class="alert alert-warning text-center">
							<i class="fas fa-spinner fa-pulse me-2"></i>Cargando información...
						</div>
					}
					else
					{
						<div class="row mb-4">

							<div class="col-md-6 mb-3">
								<label class="form-label fw-semibold">
									<i class="fas fa-file-medical"></i> Historia Clínica
								</label>
								<InputSelect class="form-select" @bind-Value="evolucion!.IdHistoriaClinica" disabled>
									<option value="0">Seleccione...</option>
									@foreach (var hc in historiasClinicas)
									{
										<option value="@hc.Id">@hc.Alergias</option>
									}
								</InputSelect>
							</div>

							<div class="col-md-6 mb-3">
								<label class="form-label fw-semibold">
									<i class="fas fa-user-md"></i> Doctor
								</label>
								<InputSelect class="form-select" @bind-Value="evolucion!.IdDoctor" disabled>
									<option value="0">Seleccione...</option>
									@foreach (var doctor in doctores)
									{
										<option value="@doctor.Id">@doctor.Nombres</option>
									}
								</InputSelect>
							</div>

							<div class="col-md-6 mb-3">
								<label class="form-label fw-semibold text-muted">
									<i class="fas fa-calendar me-1"></i> Fecha
								</label>
								<p class="form-control-plaintext fw-bold bg-light px-2">
									@evolucion.Fecha.ToLocalTime().ToString("dd/MM/yyyy")
								</p>
							</div>

							<div class="col-md-12 mb-3">
								<label class="form-label fw-semibold text-muted">
									<i class="fas fa-stethoscope me-1"></i> Diagnóstico
								</label>
								<p class="form-control-plaintext fw-bold bg-light px-2">
									@evolucion.Diagnostico
								</p>
							</div>

							<div class="col-md-12 mb-3">
								<label class="form-label fw-semibold text-muted">
									<i class="fas fa-pills me-1"></i> Tratamiento
								</label>
								<p class="form-control-plaintext fw-bold bg-light px-2">
									@evolucion.Tratamiento
								</p>
							</div>

							<div class="col-md-12 mb-3">
								<label class="form-label fw-semibold text-muted">
									<i class="fas fa-sticky-note me-1"></i> Notas
								</label>
								<p class="form-control-plaintext fw-bold bg-light px-2">
									@(string.IsNullOrEmpty(evolucion.Notas) ? "—" : evolucion.Notas)
								</p>
							</div>

						</div>

						<!-- Fechas de auditoría -->
						<hr class="my-3" />
						<h6 class="text-muted mb-3">
							<i class="fas fa-history me-1"></i> Información de Registro
						</h6>

						<div class="row">
							<!-- Fecha Creación -->
							<div class="col-md-4 mb-3">
								<label class="form-label fw-semibold text-muted">
									<i class="fas fa-calendar-plus me-1"></i> Fecha de Creación
								</label>
								<p class="form-control-plaintext bg-light px-2 rounded">
									@evolucion.FechaDeCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
								</p>
							</div>

							<!-- Fecha Modificación -->
							<div class="col-md-4 mb-3">
								<label class="form-label fw-semibold text-muted">
									<i class="fas fa-calendar-edit me-1"></i> Última Modificación
								</label>
								<p class="form-control-plaintext bg-light px-2 rounded">
									@if (evolucion.FechaDeModificacion.HasValue)
									{
										@evolucion.FechaDeModificacion.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
									}
									else
									{
										<span class="text-muted">Sin modificaciones</span>
									}
								</p>
							</div>

							<!-- Fecha Eliminación -->
							@if (evolucion.FechaDeEliminacion.HasValue)
							{
								<div class="col-md-4 mb-3">
									<label class="form-label fw-semibold text-muted">
										<i class="fas fa-calendar-times me-1"></i> Fecha de Eliminación
									</label>
									<p class="form-control-plaintext text-danger fw-bold px-2 rounded">
										@evolucion.FechaDeEliminacion.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
									</p>
								</div>
							}
						</div>
						<div class="d-flex justify-content-end gap-2 mt-3">
							<button class="btn btn-secondary px-4" @onclick="Volver">
								<i class="fas fa-arrow-left me-1"></i> Volver
							</button>
							<button class="btn btn-primary px-4" @onclick="Editar">
								<i class="fas fa-edit me-1"></i> Editar evolución
							</button>
						</div>
					}

				</div>
			</div>
		</div>
	</div>
</div>