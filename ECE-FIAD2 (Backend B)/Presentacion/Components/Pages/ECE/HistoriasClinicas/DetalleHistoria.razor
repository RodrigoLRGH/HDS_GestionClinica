@page "/detalles-historia/{id:int}"

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10 col-sm-12">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-info text-white rounded-top-4">
                    <h5 class="mb-0">
                        <i class="fas fa-file-medical-alt me-2"></i>Detalle de Historia Clínica
                    </h5>
                </div>
                <div class="card-body p-4 bg-info-subtle">
                    @if (cargando)
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-spinner fa-pulse fa-2x text-info"></i>
                            <p class="mt-2">Cargando detalles...</p>
                        </div>
                    }
                    else if (historia == null)
                    {
                        <div class="alert alert-warning text-center">
                            <i class="fas fa-exclamation-triangle me-2"></i>Historia no encontrada.
                        </div>
                    }
                    else
                    {
                        <div class="row mb-3">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold text-muted">
                                    <i class="fas fa-user me-1"></i> Paciente
                                </label>
                                <p class="form-control-plaintext fw-bold bg-light p-2 rounded">@historia.PacienteNombre</p>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold text-muted">
                                    <i class="fas fa-calendar-alt me-1"></i> Fecha Apertura
                                </label>
                                <p class="form-control-plaintext fw-bold bg-light p-2 rounded">@historia.FechaApertura.ToString("dd/MM/yyyy")</p>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-12 mb-3">
                                <label class="form-label fw-semibold text-muted">
                                    <i class="fas fa-allergies me-1"></i> Alergias
                                </label>
                                <p class="form-control-plaintext bg-light p-2 rounded">@historia.Alergias</p>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-12 mb-3">
                                <label class="form-label fw-semibold text-muted">
                                    <i class="fas fa-users me-1"></i> Antecedentes Familiares
                                </label>
                                <p class="form-control-plaintext bg-light p-2 rounded">@historia.AntecedentesFamiliares</p>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-12 mb-3">
                                <label class="form-label fw-semibold text-muted">
                                    <i class="fas fa-user me-1"></i> Antecedentes Personales
                                </label>
                                <p class="form-control-plaintext bg-light p-2 rounded">@historia.AntecedentesPersonales</p>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold text-muted">Estado</label>
                                <p class="form-control-plaintext">
                                    <span class="badge @(historia.Activo ? "bg-success" : "bg-secondary") fs-6">
                                        @(historia.Activo ? "Activo" : "Inactivo")
                                    </span>
                                </p>
                            </div>
                        </div>

                        <hr />

                        <div class="row">
                            <div class="col-md-12">
                                <small class="text-muted">
                                    <i class="fas fa-clock me-1"></i>
                                    Creada: @historia.FechaDeCreacion.ToString("dd/MM/yyyy HH:mm")
                                    @if (historia.FechaDeModificacion.HasValue)
                                    {
                                        <span class="ms-3">| Modificada: @historia.FechaDeModificacion.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                    }
                                </small>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <button class="btn btn-secondary px-4" @onclick="Volver">
                                <i class="fas fa-arrow-left me-1"></i> Volver
                            </button>
                            <button class="btn btn-primary px-4" @onclick="Editar">
                                <i class="fas fa-edit me-1"></i> Editar
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
