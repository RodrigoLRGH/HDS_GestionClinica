@page "/historial"

<div class="container mt-4">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-primary text-white rounded-top-4">
            <div class="d-flex justify-content-between align-items-center">
                <h4 class="mb-0">
                    <i class="fas fa-file-medical-alt me-2"></i>Gestión de Historias Clínicas
                </h4>
                <button class="btn btn-success" @onclick="NavegarACrear">
                    <i class="fas fa-plus-circle me-1"></i> Nueva Historia Clínica
                </button>
            </div>
        </div>

        <div class="card-body p-3 bg-primary-subtle">
            @if (cargando)
            {
                <div class="text-center py-5">
                    <i class="fas fa-spinner fa-pulse fa-2x text-primary"></i>
                    <p class="mt-2">Cargando historias clínicas...</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle bg-white rounded-3">
                        <thead class="table-light">
                            <tr>
                                <th><i class="fas fa-user me-1"></i> Paciente</th>
                                <th><i class="fas fa-calendar-alt me-1"></i> Fecha Apertura</th>
                                <th><i class="fas fa-allergies me-1"></i> Alergias</th>
                                <th><i class="fas fa-users me-1"></i> Antecedentes Familiares</th>
                                <th>Estado</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var h in historias)
                            {
                                <tr>
                                    <td class="fw-semibold">@h.PacienteNombre</td>
                                    <td>@h.FechaApertura.ToString("dd/MM/yyyy")</td>
                                    <td>@(h.Alergias?.Length > 50 ? h.Alergias.Substring(0, 50) + "..." : h.Alergias)</td>
                                    <td>@(h.AntecedentesFamiliares?.Length > 50 ? h.AntecedentesFamiliares.Substring(0, 50) + "..." : h.AntecedentesFamiliares)</td>
                                    <td>
                                        <span class="badge @(h.Activo ? "bg-success" : "bg-secondary")">
                                            @(h.Activo ? "Activo" : "Inactivo")
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-info me-1" title="Ver detalles"
                                                @onclick="() => VerDetalles(h.Id)">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button class="btn btn-sm btn-warning me-1" title="Editar"
                                                @onclick="() => Editar(h.Id)">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="btn btn-sm btn-danger" title="Eliminar"
                                                @onclick="() => ConfirmarEliminar(h.Id, h.PacienteNombre)">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
