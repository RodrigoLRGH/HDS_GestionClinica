@page "/crear-doctor"

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10 col-sm-12">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-success bg-gradient text-white rounded-top-4">
                    <h5 class="mb-0">
                        <i class="fas fa-user-plus me-2"></i>Registro de nuevo doctor
                    </h5>
                </div>
                <div class="card-body p-4 bg-success-subtle">
                    <EditForm Model="@doctorDto" OnValidSubmit="@GrabarDoctor">
                        <FluentValidator />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">
                                    <i class="fas fa-user me-1"></i> Nombres
                                </label>
                                <InputText class="form-control" placeholder="Ej: Juan Carlos"
                                           @bind-Value="doctorDto.Nombres" />
                                <ValidationMessage For="@(() => doctorDto.Nombres)" class="text-danger small" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">
                                    <i class="fas fa-user me-1"></i> Apellidos
                                </label>
                                <InputText class="form-control" placeholder="Ej: Pérez Gómez"
                                           @bind-Value="doctorDto.Apellidos" />
                                <ValidationMessage For="@(() => doctorDto.Apellidos)" class="text-danger small" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">
                                    <i class="fas fa-stethoscope me-1"></i> Especialidad
                                </label>
                                <InputSelect class="form-select" @bind-Value="doctorDto.IdEspecialidad">
                                    <option value="0">-- Selecciona especialidad --</option>
                                    @foreach (var esp in especialidades)
                                    {
                                        <option value="@esp.Id">@esp.Nombre</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => doctorDto.IdEspecialidad)" class="text-danger small" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">
                                    <i class="fas fa-calendar-alt me-1"></i> Fecha de Contratación
                                </label>
                                <InputDate class="form-control" @bind-Value="doctorDto.FechaContratacion" />
                                <ValidationMessage For="@(() => doctorDto.FechaContratacion)" class="text-danger small" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">
                                    <i class="fas fa-phone me-1"></i> Teléfono
                                </label>
                                <InputText class="form-control" placeholder="Ej: 8095551234"
                                           @bind-Value="doctorDto.Telefono" />
                                <ValidationMessage For="@(() => doctorDto.Telefono)" class="text-danger small" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">
                                    <i class="fas fa-envelope me-1"></i> Email
                                </label>
                                <InputText class="form-control" placeholder="Ej: doctor@hospital.com"
                                           @bind-Value="doctorDto.Email" />
                                <ValidationMessage For="@(() => doctorDto.Email)" class="text-danger small" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label class="form-label fw-semibold">
                                    <i class="fas fa-clock me-1"></i> Horario de Atención
                                </label>
                                <InputText class="form-control" placeholder="Ej: Lunes a Viernes 8:00 AM - 5:00 PM"
                                           @bind-Value="doctorDto.HorarioAtencion" />
                                <ValidationMessage For="@(() => doctorDto.HorarioAtencion)" class="text-danger small" />
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="button" class="btn btn-secondary px-4" @onclick="Cancelar">
                                <i class="fas fa-times me-1"></i> Cancelar
                            </button>
                            <button type="submit" class="btn btn-success px-4">
                                <i class="fas fa-save me-1"></i> Guardar Doctor
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>
