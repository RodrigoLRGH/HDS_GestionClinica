@page "/editar-doctor/{id:int}"

@inject IDoctorService DoctorService
@inject IEspecialidadService EspecialidadService
@inject IToastrService Toastr
@inject NavigationManager Navigation

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10 col-sm-12">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-warning text-dark rounded-top-4">
                    <h5 class="mb-0">
                        <i class="fas fa-user-edit me-2"></i>
                        Editar Doctor: @doctorOriginal?.Nombres @doctorOriginal?.Apellidos
                    </h5>
                </div>
                <div class="card-body p-4 bg-warning-subtle">
                    @if (doctorOriginal == null)
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-spinner fa-pulse fa-2x text-warning"></i>
                            <p class="mt-2">Cargando datos del doctor...</p>
                        </div>
                    }
                    else
                    {
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label class="form-label fw-semibold text-muted">
                                    <i class="fas fa-hashtag me-1"></i> ID Doctor
                                </label>
                                <p class="form-control-plaintext fw-bold bg-light px-2 rounded">@doctorOriginal.Id</p>
                            </div>
                        </div>

                        <h5 class="mb-3 bg-warning-subtle p-2 rounded">
                            <i class="fas fa-edit me-2"></i>Datos editables
                        </h5>
                        <hr class="my-3 text-warning" />

                        <EditForm Model="@doctorEditar" OnValidSubmit="@GrabarDoctor">
                            <FluentValidator />

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold">
                                        <i class="fas fa-user me-1"></i> Nombres
                                    </label>
                                    <InputText class="form-control fw-bold bg-light"
                                               @bind-Value="doctorEditar.Nombres" />
                                    <ValidationMessage For="@(() => doctorEditar.Nombres)" class="text-danger small" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold">
                                        <i class="fas fa-user me-1"></i> Apellidos
                                    </label>
                                    <InputText class="form-control fw-bold bg-light"
                                               @bind-Value="doctorEditar.Apellidos" />
                                    <ValidationMessage For="@(() => doctorEditar.Apellidos)" class="text-danger small" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold">
                                        <i class="fas fa-stethoscope me-1"></i> Especialidad
                                    </label>
                                    <InputSelect class="form-select fw-bold bg-light"
                                                 @bind-Value="doctorEditar.IdEspecialidad">
                                        @foreach (var esp in especialidades)
                                        {
                                            <option value="@esp.Id">@esp.Nombre</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="@(() => doctorEditar.IdEspecialidad)" class="text-danger small" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold">
                                        <i class="fas fa-calendar-alt me-1"></i> Fecha de Contratación
                                    </label>
                                    <InputDate class="form-control fw-bold bg-light"
                                               @bind-Value="doctorEditar.FechaContratacion" />
                                    <ValidationMessage For="@(() => doctorEditar.FechaContratacion)" class="text-danger small" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold">
                                        <i class="fas fa-phone me-1"></i> Teléfono
                                    </label>
                                    <InputText class="form-control fw-bold bg-light"
                                               placeholder="Ej: 8095551234"
                                               @bind-Value="doctorEditar.Telefono" />
                                    <ValidationMessage For="@(() => doctorEditar.Telefono)" class="text-danger small" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold">
                                        <i class="fas fa-envelope me-1"></i> Email
                                    </label>
                                    <InputText class="form-control fw-bold bg-light"
                                               placeholder="Ej: doctor@hospital.com"
                                               @bind-Value="doctorEditar.Email" />
                                    <ValidationMessage For="@(() => doctorEditar.Email)" class="text-danger small" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    <label class="form-label fw-semibold">
                                        <i class="fas fa-clock me-1"></i> Horario de Atención
                                    </label>
                                    <InputText class="form-control fw-bold bg-light"
                                               placeholder="Ej: Lunes a Viernes 8:00 AM - 5:00 PM"
                                               @bind-Value="doctorEditar.HorarioAtencion" />
                                </div>
                            </div>

                            <div class="d-flex justify-content-end gap-2 mt-3">
                                <button type="button" class="btn btn-secondary px-4" @onclick="Cancelar">
                                    <i class="fas fa-times me-1"></i> Cancelar
                                </button>
                                <button type="submit" class="btn btn-primary px-4">
                                    <i class="fas fa-save me-1"></i> Actualizar Doctor
                                </button>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

