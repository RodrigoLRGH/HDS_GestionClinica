@page "/doctores"

<div class="container mt-4">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-primary text-white rounded-top-4">
            <div class="d-flex justify-content-between align-items-center">
                <h4 class="mb-0">
                    <i class="fas fa-user-md me-2"></i>Listado de Doctores
                </h4>
                <button class="btn btn-success" @onclick="NavegarACrear">
                    <i class="fas fa-plus-circle me-1"></i> Nuevo Doctor
                </button>
            </div>
        </div>

        <div class="card-body p-3 bg-primary-subtle">
            @if (doctores == null)
            {
                <div class="text-center py-5">
                    <i class="fas fa-spinner fa-pulse fa-2x text-primary"></i>
                    <p class="mt-2">Cargando doctores...</p>
                </div>
            }
            else if (!doctores.Any())
            {
                <div class="alert alert-info text-center">
                    <i class="fas fa-info-circle me-2"></i> No hay doctores registrados.
                    <a href="#" @onclick:preventDefault="true" @onclick="NavegarACrear">Registrar el primero</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle bg-white rounded-3">
                        <thead class="table-light">
                            <tr>
                                <th><i class="fas fa-user me-1"></i> Nombre</th>
                                <th><i class="fas fa-stethoscope me-1"></i> Especialidad</th>
                                <th><i class="fas fa-phone me-1"></i> Teléfono</th>
                                <th><i class="fas fa-envelope me-1"></i> Email</th>
                                <th><i class="fas fa-calendar-alt me-1"></i> F. Contratación</th>
                                <th>Estado</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var doctor in doctores)
                            {
                                <tr>
                                    <td class="fw-semibold">@doctor.Nombres @doctor.Apellidos</td>
                                    <td>@doctor.NombreEspecialidad</td>
                                    <td>@(string.IsNullOrEmpty(doctor.Telefono) ? "—" : doctor.Telefono)</td>
                                    <td>@(string.IsNullOrEmpty(doctor.Email) ? "—" : doctor.Email)</td>
                                    <td>@doctor.FechaContratacion.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @if (doctor.Activo)
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactivo</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-info me-1" title="Ver detalles"
                                                @onclick="() => VerDetalles(doctor.Id)">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button class="btn btn-sm btn-warning me-1" title="Editar"
                                                @onclick="() => Editar(doctor.Id)">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="btn btn-sm btn-danger" title="Eliminar"
                                                @onclick="() => ConfirmarEliminar(doctor.Id, doctor.Nombres, doctor.Apellidos, doctor.CantidadCitas)">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
