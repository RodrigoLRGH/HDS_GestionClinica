@page "/editar-evolucion/{id:int}"


<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10 col-sm-12">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-warning text-dark rounded-top-4">
                    <h5 class="mb-0">
                        <i class="fas fa-edit me-2"></i>Editar Evolución
                    </h5>
                </div>
                <div class="card-body p-4 bg-warning-subtle">
                    @if (cargando)
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-spinner fa-pulse fa-2x text-warning"></i>
                            <p>Cargando datos...</p>
                        </div>
                    }
                    else if (evolucionOriginal == null)
                    {
                        <div class="alert alert-danger text-center">
                            Evolución no encontrada.
                        </div>
                    }
                    else
                    {
                        <EditForm Model="@evolucionEditar" OnValidSubmit="@GrabarEvolucion">
                            <FluentValidator />

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold">ID Evolución</label>
                                    <input type="text" class="form-control bg-light" value="@evolucionEditar.Id" readonly />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold">Paciente</label>
                                    <p class="form-control-plaintext fw-bold bg-light p-2 rounded">
                                        @evolucionOriginal.PacienteNombre
                                    </p>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold">Doctor</label>
                                    <p class="form-control-plaintext fw-bold bg-light p-2 rounded">
                                        @evolucionOriginal.DoctorNombre (@evolucionOriginal.EspecialidadDoctor)
                                    </p>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold">Fecha</label>
                                    <p class="form-control-plaintext fw-bold bg-light p-2 rounded">
                                        @evolucionOriginal.Fecha.ToString("dd/MM/yyyy")
                                    </p>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Diagnóstico</label>
                                <InputTextArea class="form-control" rows="3" @bind-Value="evolucionEditar.Diagnostico" />
                                <ValidationMessage For="@(() => evolucionEditar.Diagnostico)" class="text-danger small" />
                                <small class="text-muted">@(evolucionEditar.Diagnostico?.Length ?? 0) / 500</small>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Tratamiento</label>
                                <InputTextArea class="form-control" rows="3" @bind-Value="evolucionEditar.Tratamiento" />
                                <ValidationMessage For="@(() => evolucionEditar.Tratamiento)" class="text-danger small" />
                                <small class="text-muted">@(evolucionEditar.Tratamiento?.Length ?? 0) / 500</small>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Notas (opcional)</label>
                                <InputTextArea class="form-control" rows="2" @bind-Value="evolucionEditar.Notas" />
                                <small class="text-muted">@(evolucionEditar.Notas?.Length ?? 0) / 1000</small>
                            </div>

                            <div class="mb-3 form-check">
                                <InputCheckbox class="form-check-input" id="activo" @bind-Value="evolucionEditar.Activo" />
                                <label class="form-check-label" for="activo">Activo</label>
                            </div>

                            <div class="d-flex justify-content-end gap-2 mt-3">
                                <button type="button" class="btn btn-secondary px-4" @onclick="Cancelar">
                                    Cancelar
                                </button>
                                <button type="submit" class="btn btn-primary px-4" disabled="@procesando">
                                    @if (procesando)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                    }
                                    Guardar Cambios
                                </button>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
</div>