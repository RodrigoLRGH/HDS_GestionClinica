@page "/detalles-evolucion/{id:int}"

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10 col-sm-12">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-info text-white rounded-top-4">
                    <h4 class="mb-0">
                        <i class="fas fa-chart-line me-2"></i>Detalles de Evolución
                    </h4>
                </div>
                <div class="card-body p-4 bg-info-subtle">
                    @if (cargando)
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-spinner fa-pulse fa-2x text-info"></i>
                            <p class="mt-2">Cargando evolución...</p>
                        </div>
                    }
                    else if (evolucion == null)
                    {
                        <div class="alert alert-warning text-center">
                            <i class="fas fa-exclamation-triangle me-2"></i> Evolución no encontrada.
                        </div>
                    }
                    else
                    {
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-muted">
                                    <i class="fas fa-user me-1"></i> Paciente
                                </label>
                                <p class="form-control-plaintext fw-bold bg-light p-2 rounded">
                                    @evolucion.PacienteNombre
                                </p>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-muted">
                                    <i class="fas fa-user-md me-1"></i> Doctor
                                </label>
                                <p class="form-control-plaintext fw-bold bg-light p-2 rounded">
                                    @evolucion.DoctorNombre
                                </p>
                                <small class="text-muted">Especialidad: @evolucion.EspecialidadDoctor</small>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-muted">
                                    <i class="fas fa-calendar-alt me-1"></i> Fecha
                                </label>
                                <p class="form-control-plaintext fw-bold bg-light p-2 rounded">
                                    @evolucion.Fecha.ToString("dd/MM/yyyy")
                                </p>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-muted">Estado</label>
                                <p class="form-control-plaintext fw-bold bg-light p-2 rounded">
                                    @(evolucion.Activo ? "Activo" : "Inactivo")
                                </p>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold text-muted">
                                <i class="fas fa-stethoscope me-1"></i> Diagnóstico
                            </label>
                            <p class="form-control-plaintext bg-light p-2 rounded">
                                @(string.IsNullOrEmpty(evolucion.Diagnostico) ? "—" : evolucion.Diagnostico)
                            </p>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold text-muted">
                                <i class="fas fa-pills me-1"></i> Tratamiento
                            </label>
                            <p class="form-control-plaintext bg-light p-2 rounded">
                                @(string.IsNullOrEmpty(evolucion.Tratamiento) ? "—" : evolucion.Tratamiento)
                            </p>
                        </div>

                        @if (!string.IsNullOrEmpty(evolucion.Notas))
                        {
                            <div class="mb-4">
                                <label class="form-label fw-semibold text-muted">
                                    <i class="fas fa-sticky-note me-1"></i> Notas
                                </label>
                                <p class="form-control-plaintext bg-light p-2 rounded">
                                    @evolucion.Notas
                                </p>
                            </div>
                        }

                        <hr />
                        <div class="row">
                            <div class="col-md-12">
                                <small class="text-muted">
                                    <i class="fas fa-clock me-1"></i>
                                    Creada: @evolucion.FechaDeCreacion.ToString("dd/MM/yyyy HH:mm")
                                    @if (evolucion.FechaDeModificacion.HasValue)
                                    {
                                        <span class="ms-3">| Modificada: @evolucion.FechaDeModificacion.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                    }
                                    @if (evolucion.FechaDeEliminacion.HasValue)
                                    {
                                        <span class="ms-3 text-danger">| Eliminada: @evolucion.FechaDeEliminacion.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                    }
                                </small>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <button class="btn btn-secondary px-4" @onclick="Volver">
                                <i class="fas fa-arrow-left me-1"></i> Volver
                            </button>
                            <button class="btn btn-primary px-4" @onclick="Editar">
                                <i class="fas fa-edit me-1"></i> Editar evolución
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>