@page "/evoluciones"

<div class="container mt-4">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-primary text-white rounded-top-4">
            <div class="d-flex justify-content-between align-items-center">
                <h4 class="mb-0">
                    <i class="fas fa-notes-medical me-2"></i>Gestión de Evoluciones
                </h4>
                <button class="btn btn-success" @onclick="NavegarACrear">
                    <i class="fas fa-plus-circle me-1"></i> Nueva Evolución
                </button>
            </div>
        </div>

        <div class="card-body p-3 bg-primary-subtle">
            @if (cargando)
            {
                <div class="text-center py-5">
                    <i class="fas fa-spinner fa-pulse fa-2x text-primary"></i>
                    <p class="mt-2">Cargando evoluciones...</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle bg-white rounded-3">
                        <thead class="table-light">
                            <tr>
                                <th><i class="fas fa-user me-1"></i> Paciente</th>
                                <th><i class="fas fa-user-md me-1"></i> Doctor</th>
                                <th><i class="fas fa-calendar-alt me-1"></i> Fecha</th>
                                <th><i class="fas fa-diagnoses me-1"></i> Diagnóstico</th>
                                <th><i class="fas fa-pills me-1"></i> Tratamiento</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var e in evoluciones)
                            {
                                <tr>
                                    <td class="fw-semibold">@e.PacienteNombre</td>
                                    <td>@e.DoctorNombre <small class="text-muted">(@e.EspecialidadDoctor)</small></td>
                                    <td>@e.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td>@(e.Diagnostico?.Length > 50 ? e.Diagnostico.Substring(0, 50) + "..." : e.Diagnostico)</td>
                                    <td>@(e.Tratamiento?.Length > 50 ? e.Tratamiento.Substring(0, 50) + "..." : e.Tratamiento)</td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-info me-1" title="Ver detalles"
                                                @onclick="() => VerDetalles(e.Id)">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button class="btn btn-sm btn-warning me-1" title="Editar"
                                                @onclick="() => Editar(e.Id)">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="btn btn-sm btn-danger" title="Eliminar"
                                                @onclick="() => ConfirmarEliminar(e.Id, e.PacienteNombre)">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
