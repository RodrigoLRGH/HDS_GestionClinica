@page "/detalles-especialidad/{id:int}"

<div class="container mt-4">
    @if (especialidad == null)
    {
        <div class="text-center py-5">
            <i class="fas fa-spinner fa-pulse fa-2x text-primary"></i>
            <p>Cargando detalles...</p>
        </div>
    }
    else
    {
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-header bg-info text-white">
                <h4 class="mb-0"><i class="fas fa-stethoscope me-2"></i>@especialidad.Nombre</h4>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-3 fw-semibold">Descripción</div>
                    <div class="col-md-9">@(string.IsNullOrEmpty(especialidad.Descripcion) ? "Sin descripción" : especialidad.Descripcion)</div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-3 fw-semibold">Estado</div>
                    <div class="col-md-9">
                        @if (especialidad.Activo)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {

                            <span class="badge bg-secondary">Inactivo</span>
                        }
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-3 fw-semibold">Cantidad de Médicos</div>
                    <div class="col-md-9">@especialidad.CantidadMedicos</div>
                </div>
            </div>
            <div class="card-footer d-flex justify-content-between">
                <button class="btn btn-secondary" @onclick="VolverAlListado">Volver al listado</button>
                <button class="btn btn-warning" @onclick="EditarEspecialidad">Editar especialidad</button>
            </div>
        </div>
    }
</div>