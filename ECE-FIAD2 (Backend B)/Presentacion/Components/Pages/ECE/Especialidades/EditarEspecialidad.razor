@page "/editar-especialidad/{id:int}"

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10 col-sm-12">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-warning text-dark rounded-top-4">
                    <h5 class="mb-0">
                        <i class="fas fa-edit me-2"></i>Edición de especialidad
                    </h5>
                </div>
                <div class="card-body p-4 bg-warning-subtle">
                    @if (cargando)
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-spinner fa-pulse fa-2x text-warning"></i>
                            <p class="mt-2">Cargando datos...</p>
                        </div>
                    }
                    else
                    {
                        <EditForm Model="@especialidadEditar" OnValidSubmit="@GrabarEspecialidad">
                            <FluentValidator />

                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    <label class="form-label fw-semibold text-muted">
                                        <i class="fas fa-hashtag me-1"></i> ID de la Especialidad
                                    </label>
                                    <input type="text" class="form-control bg-light fw-bold"
                                           value="@especialidadOriginal?.Id" readonly />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    <label class="form-label fw-semibold">
                                        <i class="fas fa-stethoscope me-1"></i> Nombre
                                    </label>
                                    <InputText class="form-control fw-bold bg-light"
                                               @bind-Value="especialidadEditar.Nombre" />
                                    <ValidationMessage For="@(() => especialidadEditar.Nombre)" class="text-danger small" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    <label class="form-label fw-semibold">
                                        <i class="fas fa-align-left me-1"></i> Descripción
                                    </label>
                                    <InputTextArea class="form-control fw-bold bg-light" rows="4"
                                                   @bind-Value="especialidadEditar.Descripcion" />
                                    <small class="text-muted">
                                        Caracteres restantes: @(500 - (especialidadEditar.Descripcion?.Length ?? 0))
                                    </small>
                                </div>
                            </div>

                            <div class="d-flex justify-content-end gap-2 mt-3">
                                <button type="button" class="btn btn-secondary px-4" @onclick="Cancelar">
                                    <i class="fas fa-times me-1"></i> Cancelar
                                </button>
                                <button type="submit" class="btn btn-warning px-4">
                                    <i class="fas fa-save me-1"></i> Guardar Cambios
                                </button>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
