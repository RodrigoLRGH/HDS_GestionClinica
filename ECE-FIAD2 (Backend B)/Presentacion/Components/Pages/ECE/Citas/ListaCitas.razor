@page "/citas"

<div class="container mt-4">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-primary text-white rounded-top-4">
            <div class="d-flex justify-content-between align-items-center">
                <h4 class="mb-0">
                    <i class="fas fa-calendar-alt me-2"></i>Gestión de Citas
                </h4>
                <button class="btn btn-success" @onclick="NavegarACrear">
                    <i class="fas fa-plus-circle me-1"></i> Nueva Cita
                </button>
            </div>
        </div>

        <div class="card-body p-3 bg-primary-subtle">
            @if (cargando)
            {
                <div class="text-center py-5">
                    <i class="fas fa-spinner fa-pulse fa-2x text-primary"></i>
                    <p class="mt-2">Cargando citas...</p>
                </div>
            }
            else if (citas == null || !citas.Any())
            {
                <div class="alert alert-info text-center">
                    <i class="fas fa-info-circle me-2"></i> No hay citas registradas.
                    <a href="#" @onclick:preventDefault="true" @onclick="NavegarACrear">Agendar la primera</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle bg-white rounded-3">
                        <thead class="table-light">
                            <tr>
                                <th><i class="fas fa-user me-1"></i> Paciente</th>
                                <th><i class="fas fa-user-md me-1"></i> Doctor</th>
                                <th><i class="fas fa-calendar-alt me-1"></i> Fecha y Hora</th>
                                <th><i class="fas fa-comment-medical me-1"></i> Motivo</th>
                                <th>Estado</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cita in citas)
                            {
                                <tr>
                                    <td class="fw-semibold">@cita.NombrePaciente</td>
                                    <td>@cita.NombreDoctor</td>
                                    <td>@cita.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@(cita.Motivo?.Length > 50 ? cita.Motivo.Substring(0, 50) + "..." : cita.Motivo)</td>
                                    <td>
                                        <span class="badge @(cita.Estado.ToString() == "Cancelada" ? "bg-danger" : "bg-success")">
                                            @cita.Estado
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-info me-1" title="Ver detalles"
                                                @onclick="() => VerDetalles(cita.Id)">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button class="btn btn-sm btn-warning me-1" title="Editar"
                                                @onclick="() => Editar(cita.Id)">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="btn btn-sm btn-danger" title="Eliminar"
                                                @onclick="() => ConfirmarEliminar(cita.Id, cita.NombrePaciente)">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>