@page "/crear-cita"

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10 col-sm-12">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-success text-white rounded-top-4">
                    <h5 class="mb-0">
                        <i class="fas fa-calendar-plus me-2"></i>Registrar Nueva Cita
                    </h5>
                </div>
                <div class="card-body p-4 bg-success-subtle">
                    <EditForm Model="@citaDto" OnValidSubmit="@GrabarCita">
                        <FluentValidator />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">
                                    <i class="fas fa-user me-1"></i> Paciente
                                </label>
                                <InputSelect class="form-select" @bind-Value="citaDto.IdPaciente">
                                    <option value="0">-- Seleccione un paciente --</option>
                                    @foreach (var paciente in pacientes)
                                    {
                                        <option value="@paciente.Id">@paciente.Nombres</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => citaDto.IdPaciente)" class="text-danger small" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">
                                    <i class="fas fa-user-md me-1"></i> Doctor
                                </label>
                                <InputSelect class="form-select" @bind-Value="citaDto.IdDoctor">
                                    <option value="0">-- Seleccione un doctor --</option>
                                    @foreach (var doctor in doctores)
                                    {
                                        <option value="@doctor.Id">@doctor.NombreCompleto - @doctor.NombreEspecialidad</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => citaDto.IdDoctor)" class="text-danger small" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label class="form-label fw-semibold">
                                    <i class="fas fa-calendar-alt me-1"></i> Fecha y Hora
                                </label>
                                <input type="datetime-local" class="form-control"
                                       @bind-value="citaDto.FechaHora"
                                       @bind-value:event="onchange"
                                       @bind:format="yyyy-MM-ddTHH:mm" />
                                <ValidationMessage For="@(() => citaDto.FechaHora)" class="text-danger small" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label class="form-label fw-semibold">
                                    <i class="fas fa-comment-medical me-1"></i> Motivo de la cita
                                </label>
                                <InputTextArea class="form-control" rows="3"
                                               placeholder="Describa el motivo de la consulta..."
                                               @bind-Value="citaDto.Motivo" />
                                <ValidationMessage For="@(() => citaDto.Motivo)" class="text-danger small" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label class="form-label fw-semibold">
                                    <i class="fas fa-sticky-note me-1"></i> Notas adicionales (opcional)
                                </label>
                                <InputTextArea class="form-control" rows="2"
                                               placeholder="Información adicional relevante..."
                                               @bind-Value="citaDto.Notas" />
                                <ValidationMessage For="@(() => citaDto.Notas)" class="text-danger small" />
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="button" class="btn btn-secondary px-4" @onclick="Cancelar">
                                <i class="fas fa-times me-1"></i> Cancelar
                            </button>
                            <button type="submit" class="btn btn-success px-4" disabled="@procesando">
                                @if (procesando)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                }
                                <i class="fas fa-save me-1"></i> Guardar Cita
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>