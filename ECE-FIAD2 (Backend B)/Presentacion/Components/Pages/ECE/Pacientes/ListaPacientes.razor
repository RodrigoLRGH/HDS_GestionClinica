@page "/pacientes"
@using Dominio.Enumeraciones
@using Aplicacion.Helpers
@using Aplicacion.DTOs.Pacientes

<div class="container mt-4">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-primary text-white rounded-top-4">
            <div class="d-flex justify-content-between align-items-center">
                <h4 class="mb-0">
                    <i class="fas fa-users me-2"></i>Listado de Pacientes
                </h4>
                <button class="btn btn-success" @onclick="NavegarACrear">
                    <i class="fas fa-plus-circle me-1"></i> Nuevo Paciente
                </button>
            </div>
        </div>

        <div class="card-body p-2 bg-primary-subtle">
            <div class="d-flex justify-content-end">
                <button class="btn btn-sm btn-warning mt-0 m-2" @onclick="CambiaEstilo">
                    <i class="@(EstiloCard ? "fas fa-list" : "fas fa-th")"></i>
                    @(EstiloCard ? "Formato Listado" : "Formato Card")
                </button>
            </div>

            @if (pacientes == null)
            {
                <div class="text-center py-5">
                    <i class="fas fa-spinner fa-pulse fa-2x text-primary"></i>
                    <p class="mt-2">Cargando...</p>
                </div>
            }
            else if (!pacientes.Any())
            {
                <div class="alert alert-info text-center">
                    <i class="fas fa-info-circle me-2"></i> No hay pacientes.
                    <a href="#" @onclick:preventDefault="true" @onclick="NavegarACrear">Crear el primero</a>
                </div>
            }
            else
            {
                @if (EstiloCard)
                {
                    <div class="row g-4 p-2">
                        @foreach (var paciente in pacientes)
                        {
                            <div class="col-md-6 col-lg-4">
                                <div class="card h-100 shadow-sm border-0 rounded-3 p-3">
                                    <h5 class="fw-semibold">@paciente.Nombres @paciente.Apellidos</h5>
                                    <p class="text-muted mb-2">
                                        <i class="fas fa-envelope me-1"></i> @paciente.Email<br />
                                        <i class="fas fa-phone me-1"></i> @paciente.Telefono
                                    </p>
                                    <hr />
                                    <div class="text-muted small">
                                        <i class="fas fa-calendar-alt me-1"></i> Última cita: Sin cita
                                    </div>
                                    <div class="d-flex justify-content-end mt-3 gap-1">
                                        <button class="btn btn-sm btn-info" title="Ver detalles"
                                                @onclick="() => VerDetalles(paciente.Id)">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button class="btn btn-sm btn-warning" title="Editar"
                                                @onclick="() => Editar(paciente.Id)">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="btn btn-sm btn-danger" title="Eliminar"
                                                @onclick="() => ConfirmarEliminar(paciente.Id, paciente.Nombres, paciente.Apellidos)">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover table-striped align-middle bg-white rounded-3">
                            <thead class="table-light">
                                <tr>
                                    <th><i class="fas fa-user me-1"></i> Nombre</th>
                                    <th><i class="fas fa-id-card me-1"></i> N° Documento</th>
                                    <th><i class="fas fa-envelope me-1"></i> Email</th>
                                    <th>Estado</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var paciente in pacientes)
                                {
                                    <tr>
                                        <td class="fw-semibold">@paciente.Nombres @paciente.Apellidos</td>
                                        <td>@paciente.NumeroDocumento</td>
                                        <td>@paciente.Email</td>
                                        <td>
                                            @if (paciente.Activo)
                                            {
                                                <span class="badge bg-success">Activo</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Inactivo</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <button class="btn btn-sm btn-info me-1" title="Ver detalles"
                                                    @onclick="() => VerDetalles(paciente.Id)">
                                                <i class="fas fa-eye"></i>
                                            </button>
                                            <button class="btn btn-sm btn-warning me-1" title="Editar"
                                                    @onclick="() => Editar(paciente.Id)">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button class="btn btn-sm btn-danger" title="Eliminar"
                                                    @onclick="() => ConfirmarEliminar(paciente.Id, paciente.Nombres, paciente.Apellidos)">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>
    </div>
</div>
